<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the Flutter UI
         initializes. Shows the app's brand navy background (see
         @drawable/launch_background and colors.xml) instead of the
         default white flash, matching the tone the animated Flutter
         splash screen opens on for a seamless handoff. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Theme applied to the Android Window as soon as the Flutter engine
         draws its first frame. Uses the system's background color instead
         of a bespoke drawable so light/dark follow the device setting
         automatically without an extra asset to maintain. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
